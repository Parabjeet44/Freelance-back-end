generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  email            String    @unique
  password         String
  role             Role
  mobile           String?   // NEW: Mobile number field
  refreshToken     String?   @unique

  // Relationships
  projects         Project[] @relation("BuyerProjects")
  assignedProjects Project[] @relation("SellerProject")
  bids             Bid[]
  deliverables     Deliverable[]
}

model Project {
  id          Int       @id @default(autoincrement())
  title       String
  description String
  budgetMin   Int
  budgetMax   Int
  deadline    DateTime
  status      Status    @default(PENDING)
  
  buyer       User      @relation("BuyerProjects", fields: [buyerId], references: [id])
  buyerId     Int

  seller      User?     @relation("SellerProject", fields: [sellerId], references: [id])
  sellerId    Int?

  bids        Bid[]
  deliverable Deliverable?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Deliverable {
  id          Int      @id @default(autoincrement())
  project     Project  @relation(fields: [projectId], references: [id])
  projectId   Int      @unique
  seller      User     @relation(fields: [sellerId], references: [id])
  sellerId    Int
  
  // Separate fields for each file type
  pdfUrl      String?   // PDF file
  zipUrl      String?   // ZIP file
  videoUrl    String?   // Video file
  
  // External links
  pdfLink     String?   // External PDF link
  zipLink     String?   // External ZIP link
  videoLink   String?   // External video link
  
  uploadedAt  DateTime @default(now())
}
model Bid {
  id             Int      @id @default(autoincrement())
  project        Project  @relation(fields: [projectId], references: [id])
  projectId      Int
  seller         User     @relation(fields: [sellerId], references: [id])
  sellerId       Int
  amount         Int
  estimatedTime  String
  message        String
  createdAt      DateTime @default(now())
}

enum Role {
  BUYER
  SELLER
}

enum Status {
  PENDING
  IN_PROGRESS
  COMPLETED
}